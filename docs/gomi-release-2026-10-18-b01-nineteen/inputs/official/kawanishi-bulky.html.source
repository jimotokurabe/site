<th scope="col">正午～午後1時</th>
<th scope="col">午後1時～2時</th>
<th scope="col">午後2時～4時</th>
</tr>
</thead>
<tbody>
<tr>
<th scope="row">月曜日</th>
<td><strong><span class="red">非常に混雑</span></strong></td>
<td>
<p>混雑</p>
</td>
<td>
<p>混雑</p>
</td>
<td>
<p>やや混雑</p>
</td>
