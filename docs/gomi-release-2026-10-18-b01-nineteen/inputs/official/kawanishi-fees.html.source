<form accept-charset="UTF-8" action="https://www.city.kawanishi.hyogo.jp/cgi-bin/quick-enquetes/G11001001" method="post"><input name="confirming" type="hidden" value="false" /> <input name="page_title" type="hidden" value="対象となる大型ごみと処理手数料" /> <input name="page_url" type="hidden" value="https://www.city.kawanishi.hyogo.jp/kurashi/gomi_kankyo/gomi/1001346/1001349.html" />
