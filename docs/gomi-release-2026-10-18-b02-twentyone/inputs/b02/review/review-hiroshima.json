  "findings": [
    {
      "id": "H01",
      "severity": "required",
      "fields": [
        "hiroshima-carry.eligibility"
      ],
      "source": "hiroshima-bulky-support.txt",
      "lines": [
        284,
        303
      ],
      "finding": "単身者にも資格ORを共通ANDする構造は原文より狭い。資格1～5は同居人がいる場合の非該当者数条件に使われる。",
      "proposal": "持出困難AND[ひとり暮らしOR同居世帯で本人・同居人の非該当者1人以下→対象の場合あり]。資格一覧を同居側に含め、ほかにも対象の場合あり・相談を残す。"
    },
    {
      "id": "H02",
      "severity": "required",
      "fields": [
        "hiroshima-regular.fees",
        "hiroshima-regular.limits"
      ],
      "source": "hiroshima-regular.txt",
      "lines": [
        306,
        321
      ],
      "finding": "点数/3000円制限は一般予約の注意事項で経路限定ではない。家電リサイクル対象機器は1点1000円として扱う例外と生活保護等の免除制度案内が欠落。",
      "proposal": "家電リサイクル対象機器の算定例外、生活保護/中国残留邦人等支援給付世帯の免除制度（詳細は窓口確認）を補完。"
    },
    {
      "id": "H03",
      "severity": "required",
      "fields": [
        "hiroshima-dropoff.attendance",
        "priority_notes"
      ],
      "source": "hiroshima-self-dropoff.txt",
      "lines": [
        285,
        286,
        335,
        342
      ],
      "finding": "原典は申請者本人による搬入と原則本人の荷降ろし。本人が運転しなければならないとの限定はない。",
      "proposal": "運転者=申請者・原則本人が運転という条件を削除。本人搬入と家族等の運転可否の事前確認を区別。"
    },
    {
      "id": "H04",
      "severity": "recommended",
      "fields": [
        "hiroshima-daily.limits"
      ],
      "source": "hiroshima-fureai.txt",
      "lines": [
        293,
        295
      ],
      "finding": "希望者にごみが出ていない場合の声かけ・緊急連絡先への電話連絡がある。現在の10項目にはこの利用価値が未掲載。",
      "proposal": "希望者への声かけ/緊急連絡の支援を短く追記。"
    }
  ],
