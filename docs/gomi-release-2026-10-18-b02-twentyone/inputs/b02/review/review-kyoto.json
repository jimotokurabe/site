  "findings": [
    {
      "id": "K01",
      "severity": "required",
      "fields": [
        "kyoto-daily.eligibility"
      ],
      "source": "kyoto-daily-criteria.txt",
      "lines": [
        15,
        20
      ],
      "finding": "サービス利用/ホームヘルプ条件と65歳以上等の属性がトップレベルanyで並ぶため、属性だけで対象に見える。原典はすべてAND。",
      "proposal": "市内居住AND排出困難AND本人親族近隣協力不可AND[(介護保険OR障害福祉)サービス利用ANDホームヘルプ利用]AND[65歳以上OR障害OR同様者のみ同居]。添付資料日付と現行適用の確認質問は維持。"
    },
    {
      "id": "K02",
      "severity": "required",
      "fields": [
        "kyoto-daily-pilot.eligibility"
      ],
      "source": "kyoto-pilot.txt",
      "lines": [
        64,
        83
      ],
      "finding": "通常資格構造が複製されホームヘルプ条件緩和が反映されていない。学区/既存利用不可もexceptionだけに依存。",
      "proposal": "その他の共通条件をAND維持しサービス条件を介護保険サービス利用OR障害福祉サービス利用に緩和。対象14学区の居住、既存利用者申請不可、現行条件該当者は通常へを表示・メモに残す。"
    },
    {
      "id": "K03",
      "severity": "required",
      "fields": [
        "kyoto-daily-pilot.collection_location"
      ],
      "source": "kyoto-pilot.txt",
      "lines": [
        58,
        63
      ],
      "finding": "実験経路の場所欄に「市内全域の通常サービス」が混入している。",
      "proposal": "玄関先・屋内立入なしは維持し、実験は14学区限定と明示。全市通常は通常経路へ。"
    },
    {
      "id": "K04",
      "severity": "required",
      "fields": [
        "kyoto-daily-pilot.limits"
      ],
      "source": "kyoto-pilot.txt",
      "lines": [
        123,
        131
      ],
      "finding": "片手で持てる重さ・品目ごと2袋(束)の制限を追加3品目にのみ限定しているが、原典128は排出できるごみ全体の規則。転居で実験サービス終了条件も未掲載。",
      "proposal": "各品目2袋(束)・片手で持てる重さは実験の全品目。追加3品目のみ2営業日前届出（透明袋・品目表示）と区別。転居で終了(pilot109)も明記。"
    },
    {
      "id": "K05",
      "severity": "required",
      "fields": [
        "kyoto-daily-pilot.application",
        "kyoto-daily-pilot.questions_for_office"
      ],
      "source": "kyoto-pilot.txt / kyoto-daily.txt / kyoto-pilot-background.txt",
      "lines": [
        95,
        96,
        54,
        59,
        60
      ],
      "finding": "詳細ページは提供期間2027年9月末、通常案内は実験期間2027年3月末、背景ページは実験終了後も全市展開まで継続予定。単に提供期間9月予定だけでは実験期間との区別が伝わらない。",
      "proposal": "社会実験は2026-10-01～2027-03-31、詳細案内のサービス提供期間2027-09末予定を区別し、実際の終了日・継続条件は窓口確認とする。12/28申請期限は維持。"
    },
    {
      "id": "K06",
      "severity": "recommended",
      "fields": [
        "kyoto-daily.waste_scope",
        "kyoto-daily.collection_location",
        "kyoto-daily.application"
      ],
      "source": "kyoto-pilot.txt",
      "lines": [
        81,
        96
      ],
      "finding": "通常経路にも実験の追加品目・申請期限・届出等が混在。別実験経路を設けた意義が薄まり通常利用者が実験期限を自分の期限と誤認する恐れ。",
      "proposal": "通常経路を通常5種・通常申請中心にし、実験の詳細は実験経路を参照と短く誘導。"
    }
  ],
