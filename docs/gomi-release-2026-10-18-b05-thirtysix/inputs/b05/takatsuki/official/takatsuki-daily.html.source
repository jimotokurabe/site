					<div id="main_header">
						<h1>高齢者等のごみ出しを支援します</h1>
					</div>

					<div class="content_header_wrap">
						<!-- SDGsアイコンここから -->
						
						<!-- SDGsアイコンここまで -->
						<div id="content_header">
							<span class="open_page_id">ページID：166846</span>
							<span class="date">更新日：2026年8月14日更新</span>
