      </td>
      <td>
        <p align="center"><b>&times;</b></p>
      </td>
      <td>
        <p align="center"><b>&times;</b></p>
      </td>
    </tr>
    <tr>
      <td>
        <p align="center">燃やせない<br />
        ごみ</p>
      </td>
      <td>
        <p align="center"><b>&times;</b></p>
      </td>
      <td>
        <p align="center"><b>&times;</b></p>
      </td>
      <td>
        <p align="center">&nbsp;</p>

        <p align="center">（※平日のみ）</p>
      </td>
    </tr>
    <tr>
      <td>
        <p align="center">燃やせる<br />
        粗大ごみ</p>
      </td>
      <td>
        <p align="center">&nbsp;</p>
      </td>
      <td>
        <p align="center">&nbsp;</p>
      </td>
      <td>
        <p align="center">&nbsp;</p>
      </td>
    </tr>
    <tr>
      <td>
        <p align="center">燃やせない<br />
        粗大ごみ</p>
      </td>
      <td>
        <p align="center"><b>&times;</b></p>
      </td>
      <td>
        <p align="center">&nbsp;</p>
      </td>
      <td>
        <p align="center">&nbsp;</p>
      </td>
    </tr>
    <tr>
      <td>
        <p align="center">注意事項</p>
      </td>
      <td>
        <p align="center">プラスチック類は<br />
        持ち込めません</p>

        <p align="center">第2日曜日は粗大ごみ<br />
        のみ受入</p>
      </td>
      <td>
        <p align="center">事業所のごみは<br />
        持ち込めません</p>
      </td>
      <td>
