            <article id="contents" role="main">

                                
      <h1 class="title"><span class="bg"><span class="bg2">持ち込み場所</span></span></h1>
                  
              <div id="social-update-area">
                                                                                  <div id="social" class="rs_preserve">
        <div class="clearfix in">

