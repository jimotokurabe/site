<script type="text/javascript">
    jQuery.noConflict();
    jQuery(function () {

        var setPopNaviArea,setHideNaviArea;

        // 2016/09/15 アクセシビリティ対応 <div>→<ul>
        jQuery("li.navi_tab,ul.g_navi").on({
            'mouseenter': function () {

                var id = jQuery(this).attr("id");

                if (jQuery(this).hasClass("navi_tab")) {
                    id = id.replace("navi_tab_", "");
                } else if (jQuery(this).hasClass("g_navi")) {
                    id = id.replace("g_navi_", "");
                }

                clearTimeout(setHideNaviArea);

                setPopNaviArea = setTimeout(function () {
                    jQuery("li.navi_tab").each(function () {
                        if (jQuery(this).attr("id") == "navi_tab_" + id) {
                            jQuery(this).addClass("selected");
                            jQuery(this).attr("aria-selected", "true");
                        } else {
                            jQuery(this).removeClass("selected");
                            jQuery(this).attr("aria-selected", "false");
                        }
                    });

                    jQuery("ul.g_navi").each(function () {
                        if (jQuery(this).attr("id") == "g_navi_" + id) {
                            const isOpen = jQuery(this).attr('aria-expanded') === 'true';
                            jQuery(this).attr('aria-expanded', !isOpen);
                            jQuery('#g_navi_' + id).addClass('is-open');
                            jQuery('#g_navi_' + id).prop('hidden', false);
                        } else {
                            jQuery(this).attr('aria-expanded', false);
                            jQuery(this).removeClass('is-open');
                            jQuery(this).prop('hidden', true);
                        }
                        //(jQuery(this).attr("id") == "g_navi_" + id) ? jQuery(this).show() : jQuery(this).hide();
                    });
                }, 400);
            },
            'mouseleave': function () {

                clearTimeout(setPopNaviArea);

                setHideNaviArea = setTimeout(function () {
                    jQuery("li.navi_tab").removeClass("selected");
                    jQuery("li.navi_tab").attr("aria-selected", "false");
                    jQuery('ul.g_navi').attr('aria-expanded', false);
                    jQuery('ul.g_navi').removeClass('is-open');
                    jQuery('ul.g_navi').prop('hidden', true);
                }, 50);
            },

            'focusin': function () {

                var id = jQuery(this).attr("id");

                if (jQuery(this).hasClass("navi_tab")) {
                    id = id.replace("navi_tab_", "");
                } else if (jQuery(this).hasClass("g_navi")) {
                    id = id.replace("g_navi_", "");
                }

                clearTimeout(setHideNaviArea);

                setPopNaviArea = setTimeout(function () {
                    jQuery("li.navi_tab").each(function () {
                        if (jQuery(this).attr("id") == "navi_tab_" + id) {
                            jQuery(this).addClass("selected");
                            jQuery(this).attr("aria-selected", "true");
                        } else {
                            jQuery(this).removeClass("selected");
                            jQuery(this).attr("aria-selected", "false");
                        }
                    });

                    jQuery("ul.g_navi").each(function () {
                        if (jQuery(this).attr("id") == "g_navi_" + id) {
                            const isOpen = jQuery(this).attr('aria-expanded') === 'true';
                            jQuery(this).attr('aria-expanded', !isOpen);
                            jQuery('#g_navi_' + id).addClass('is-open');
                            jQuery('#g_navi_' + id).prop('hidden', false);
                        } else {
                            jQuery(this).attr('aria-expanded', false);
                            jQuery(this).removeClass('is-open');
                            jQuery(this).prop('hidden', true);
                        }
                    });
                }, 1);
            },
            'focusout': function () {

                clearTimeout(setPopNaviArea);

                setHideNaviArea = setTimeout(function () {
                    jQuery("li.navi_tab").removeClass("selected");
                    jQuery("li.navi_tab").attr("aria-selected", "false");
                    jQuery('ul.g_navi').attr('aria-expanded', false);
                    jQuery('ul.g_navi').removeClass('is-open');
                    jQuery('ul.g_navi').prop('hidden', true);
                }, 1);
            }
        });

        if (jQuery("#globalNavigationData").length) {
            var classid = jQuery("#globalNavigationData").attr("data-classid");
            var topid = jQuery("#globalNavigationData").attr("data-topid");

            jQuery('[data-global="' + classid + '"]').addClass("now");
            if (topid > 0) {
                jQuery('[data-global="' + topid + '"]').addClass("now");
            }
        }
    });
</script>
