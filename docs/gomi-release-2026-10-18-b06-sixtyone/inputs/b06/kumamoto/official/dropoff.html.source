            }
            setFloatHeader(prm, "//www.city.kumamoto.jp/dynamic/kankyo/");
            
        });

        function setFontSizeIconArr() {
            var fontSizeIconArr = {
                "標準": { size: "fontSizeN", on: "https://www.city.kumamoto.jp/dynamic/kankyo/common/images/top1/black-mozi-m.gif", off: "https://www.city.kumamoto.jp/dynamic/kankyo/common/images/top1/white-mozi-m.gif" },
                "拡大": { size: "fontSizeB", on: "https://www.city.kumamoto.jp/dynamic/kankyo/common/images/top1/black-mozi-l.gif", off: "https://www.city.kumamoto.jp/dynamic/kankyo/common/images/top1/white-mozi-l.gif" },
            };

            return fontSizeIconArr;
        }
