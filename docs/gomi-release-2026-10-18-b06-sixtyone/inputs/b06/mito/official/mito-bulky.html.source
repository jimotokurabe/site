					<div id="main_header">
						<h1>粗大ごみの出し方について</h1>
					</div>

					<div class="content_header_wrap">
						<!-- SDGsアイコンここから -->
						
						<!-- SDGsアイコンここまで -->
						<div id="content_header">
							<span class="open_page_id">ページID：0004737</span>
