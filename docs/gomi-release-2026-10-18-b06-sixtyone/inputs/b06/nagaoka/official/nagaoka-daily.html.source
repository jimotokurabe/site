<!--===== 2カラム：コンテンツエリア start ===============-->
		<div id="contentsarea2cal">

		<!-- メインコンテンツ -->
		<div id="contents">

		<div class="titlebox">
			<h2><!-- WCVTITLE -->ふれあい収集制度<!-- /WCVTITLE --></h2>
			<p><!-- WCVTEXT -->最終更新日　2025年4月1日<!-- /WCVTEXT --></p>
		</div>

		<div class="layout1">
<!-- WCVTABLE!../../_rows/template.rows -->
<!-- WCVROW!title2!14243944560 -->
<div class="ttl1"><p><!-- WCVTEXT -->ふれあい収集制度とは<!-- /WCVTEXT --></p></div>
<!-- /WCVROW -->
<!-- WCVROW!text1!17092678710 -->
<div class="txt1"><p><!-- WCVTEXT -->申請により、ごみと資源物を戸別収集します。<!-- /WCVTEXT --></p></div>
<!-- /WCVROW -->
<!-- WCVROW!text1!17092678711 -->
<div class="txt1"><p><!-- WCVTEXT --><strong>（1）対象</strong><br />
ごみステーションまでごみを持っていくことが困難な高齢者または障害者世帯<!-- /WCVTEXT --></p></div>
<!-- /WCVROW -->
<!-- WCVROW!text1!17092678712 -->
<div class="txt1"><p><!-- WCVTEXT --><strong>（2）利用料</strong><br />
無料<!-- /WCVTEXT --></p></div>
<!-- /WCVROW -->
<!-- WCVROW!text1!17092678713 -->
<div class="txt1"><p><!-- WCVTEXT --><strong>（3）申請方法・申請先</strong><br />
各世帯担当のホームヘルパー、ケアマネージャーなどを通じて、環境事業課または各支所地域振興・市民生活課にご連絡ください。<!-- /WCVTEXT --></p></div>
<!-- /WCVROW -->
<!-- WCVROW!text1!17092678714 -->
<div class="txt1"><p><!-- WCVTEXT --><strong>（4）分別方法</strong><br />
通常のごみステーションに出すときと同様に分別していただきます。<br />
（燃やすごみ、燃やさないごみ、生ごみは指定ごみ袋が必要です）<!-- /WCVTEXT --></p></div>
<!-- /WCVROW -->
<!-- WCVROW!text1!17092678715 -->
<div class="txt1"><p><!-- WCVTEXT --><strong>（5）その他</strong><br />
ふれあい収集開始後、一時的に不在となる場合、利用の再開を希望される場合やふれあい収集が不要となった場合は、環境事業課または各支所地域振興・市民生活課にご連絡ください。<!-- /WCVTEXT --></p></div>
<!-- /WCVROW -->
<!-- WCVROW!text1!14243944561 -->
<div class="txt1"><p><!-- WCVTEXT -->申請書類は、「<a href="../../download/cate03/index.html#6">申請書様式のダウンロード</a>」のページからダウンロードできます。<!-- /WCVTEXT --></p></div>
<!-- /WCVROW -->
<!-- /WCVTABLE --></div>


		<div class="tantouwaku">
			<div class="tantoubox">
				<div class="tantouttl"><p>このページの担当</p></div>
				<div class="tantoulist">
				<dl>
<!-- WCVTABLE!../../_rows/toiawase.rows -->
<!-- WCVROW!contactC3073!99001 -->
<dt class="C3073"><!-- WCVTEXT -->環境事業課<!-- /WCVTEXT --></dt>
<dd><!-- WCVTEXT -->〒940-0015　新潟県長岡市寿3-6-1（環境衛生センター）<br />
TEL：0258-24-2837　　FAX：0258-24-6553<!-- /WCVTEXT -->
<button class="contact_btn" data-cid="C3073">このページの作成担当にメールを送る</button></dd>
<!-- /WCVROW -->
<!-- /WCVTABLE -->
				</dl>
				</div>
			</div>
		</div>

