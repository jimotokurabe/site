<div id="snsline"><a href="https://line.me/R/msg/text/?%E3%82%B4%E3%83%9F%E3%81%AE%E5%8F%8E%E9%9B%86%E3%81%AB%E3%81%A4%E3%81%84%E3%81%A6%28%E4%BB%A4%E5%92%8C5%E5%B9%B46%E6%9C%8816%E6%97%A5%29%ef%bd%9c%E5%AF%8C%E5%B1%B1%E5%B8%82%E5%85%AC%E5%BC%8F%E3%82%A6%E3%82%A7%E3%83%96%E3%82%B5%E3%82%A4%E3%83%88%0d%0ahttps%3A%2F%2Fwww.city.toyama.lg.jp%2Fshisei%2Fkoho%2F1010862%2F1012156%2F1010863%2F1013569%2F1013641.html" target="_blank"><img alt="ラインでシェア" height="40" src="../../../../../../_template_/_site_/_default_/_res/images/sns/lineit.png" width="40"></a></div>
