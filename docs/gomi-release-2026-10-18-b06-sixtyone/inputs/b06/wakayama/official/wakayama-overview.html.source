</div>

<div id="snsline">
<div class="line-it-button" data-lang="ja" data-type="share-a" data-env="REAL" data-url="https://www.city.wakayama.wakayama.jp/kurashi/gomi_kankyo/1001113/1001251/1018293/index.html" data-color="default" data-size="small" data-count="false" data-ver="3" style="display: none;"></div>
